            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "query",
                "description": "Filter by scheduling organization ID"
              },
              {
                "name": "startDate",
                "value": "",
                "type": "query",
                "description": "Start date for labor demand retrieval"
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query",
                "description": "End date for labor demand retrieval"
              }
            ]
          },
          "docs": "Returns labor demand instances for scheduling planning."
        },
        {
          "info": {
            "name": "Create Labor Demand",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{tenant}.workday.com/api/absence-management/v1/laborDemand",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new labor demand entry for workforce planning."
        }
      ]
    }
  ],
  "bundled": true
}