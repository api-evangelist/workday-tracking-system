{
  "opencollection": "1.0.0",
  "info": {
    "name": "Workday Absence Management Accruals Time Requests API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Time Requests",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Time Requests",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenant}.workday.com/api/absence-management/v1/workers/:workerId/timeRequests",
            "params": [
              {
                "name": "workerId",
                "value": "",
                "type": "path",
                "description": "The Workday ID of the worker"
              },
              {
                "name": "startDate",
                "value": "",
                "type": "query",
                "description": "Start date for time request retrieval (YYYY-MM-DD)"
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query",
                "description": "End date for time request retrieval (YYYY-MM-DD)"
              }
            ]
          },
          "docs": "Retrieves time requests for a worker."
        },
        {
          "info": {
            "name": "Create Time Request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{tenant}.workday.com/api/absence-management/v1/workers/:workerId/timeRequests",
            "params": [
              {
                "name": "workerId",
                "value": "",
                "type": "path",
                "description": "The Workday ID of the worker"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new user time request or updates an existing one."
        }
      ]
    }
  ],
  "bundled": true
}